<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="aruco_plane">
    <static>true</static>

    <link name="link">
      <visual name="aruco_box">
        <geometry>
          <box>
            <size>3.4 3.4 0.05</size>
          </box>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_plane/aruco_grid.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
