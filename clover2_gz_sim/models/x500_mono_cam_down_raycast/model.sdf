<?xml version="1.0" encoding="UTF-8" ?>
<sdf version='1.9'>
  <model name='x500_mono_cam_down_raycast'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0.05 0 -0.07 0 1.5707 3.1415926</pose>
      <name>mono_cam</name>
    </include>

    <link name="rangefinder_link">
      <pose relative_to="base_link">0 0 -0.07 0 1.5707 3.1415926</pose>
      <inertial>
        <pose>0 0 0.0435 0 0 0</pose>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00034437749999999994</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00034437749999999994</iyy>
          <iyz>0</iyz>
          <izz>0.00022199999999999998</izz>
        </inertia>
      </inertial>
      <visual name="rangefinder/visual/lens">
        <pose>0.015 0 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!-- Use physics raycasts for the rangefinder with Ogre1. -->
    <plugin
      filename="clover2-rangefinder-system"
      name="clover2::sim::RangefinderSystem">
      <link_name>rangefinder_link</link_name>
      <frame_name>rangefinder_link</frame_name>
      <pose>0 0 0 0 0 0</pose>
      <topic>/rangefinder</topic>
      <samples>10</samples>
      <min_angle>-0.0872</min_angle>
      <max_angle>0.0872</max_angle>
      <min_range>0.1</min_range>
      <max_range>30</max_range>
      <update_rate>10</update_rate>
      <noise_stddev>0.01</noise_stddev>
    </plugin>

    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <joint name="RangefinderJoint" type="fixed">
      <parent>base_link</parent>
      <child>rangefinder_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

  </model>
</sdf>
