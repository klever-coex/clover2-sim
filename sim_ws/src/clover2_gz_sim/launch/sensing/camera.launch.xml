<launch>
    <arg
        name="camera_name"
        default="camera"
        description="Camera name (used as ROS namespace and default frame_id prefix)"
    />
    <arg
        name="container_name"
        default="camera_container"
        description="Component container name (used when use_composition=true)"
    />
    <arg name="frame_id" default="$(var camera_name)_link" description="Camera frame_id in image messages" />
    <arg name="ns" default="" description="ROS namespace" />
    <arg
        name="use_composition"
        default="false"
        description="If true, load RosGzBridge as composable node into existing container"
    />

    <arg name="world_name" default="clover2_aruco" description="Gazebo world name" />
    <arg name="model_name" default="px4" description="Model name in Gazebo" />
    <arg name="camera_link" default="camera_link" description="Link carrying the camera sensor in the SDF model" />
    <arg name="camera_sensor" default="imager" description="Camera sensor name in the SDF model" />
    <arg name="use_sim_time" default="true" description="Use simulation (Gazebo) clock" />

    <let
        name="gz_image_topic"
        value="/world/$(var world_name)/model/$(var model_name)/link/$(var camera_link)/sensor/$(var camera_sensor)/image"
    />
    <let
        name="gz_camera_info_topic"
        value="/world/$(var world_name)/model/$(var model_name)/link/$(var camera_link)/sensor/$(var camera_sensor)/camera_info"
    />

    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        name="$(var camera_name)"
        namespace="$(var ns)"
        unless="$(var use_composition)"
    >
        <param name="use_sim_time" value="$(var use_sim_time)" />

        <param name="bridge_names" value="[camera_image, camera_info]" />

        <param name="bridges.camera_image.ros_topic_name" value="~/image_raw" />
        <param name="bridges.camera_image.gz_topic_name" value="$(var gz_image_topic)" />
        <param name="bridges.camera_image.ros_type_name" value="sensor_msgs/msg/Image" />
        <param name="bridges.camera_image.gz_type_name" value="gz.msgs.Image" />
        <param name="bridges.camera_image.direction" value="GZ_TO_ROS" />
        <param name="bridges.camera_image.frame_id" value="$(var frame_id)" />

        <param name="bridges.camera_info.ros_topic_name" value="~/camera_info" />
        <param name="bridges.camera_info.gz_topic_name" value="$(var gz_camera_info_topic)" />
        <param name="bridges.camera_info.ros_type_name" value="sensor_msgs/msg/CameraInfo" />
        <param name="bridges.camera_info.gz_type_name" value="gz.msgs.CameraInfo" />
        <param name="bridges.camera_info.direction" value="GZ_TO_ROS" />
        <param name="bridges.camera_info.frame_id" value="$(var frame_id)" />
    </node>

    <load_composable_node target="$(var container_name)">
        <composable_node
            pkg="ros_gz_bridge"
            plugin="ros_gz_bridge::RosGzBridge"
            name="camera"
            namespace="$(var ns)"
            if="$(var use_composition)"
        >
            <param name="use_sim_time" value="$(var use_sim_time)" />

            <param name="bridge_names" value="[camera_image, camera_info]" />

            <param name="bridges.camera_image.ros_topic_name" value="~/image_raw" />
            <param name="bridges.camera_image.gz_topic_name" value="$(var gz_image_topic)" />
            <param name="bridges.camera_image.ros_type_name" value="sensor_msgs/msg/Image" />
            <param name="bridges.camera_image.gz_type_name" value="gz.msgs.Image" />
            <param name="bridges.camera_image.direction" value="GZ_TO_ROS" />
            <param name="bridges.camera_image.frame_id" value="$(var frame_id)" />

            <param name="bridges.camera_info.ros_topic_name" value="~/camera_info" />
            <param name="bridges.camera_info.gz_topic_name" value="$(var gz_camera_info_topic)" />
            <param name="bridges.camera_info.ros_type_name" value="sensor_msgs/msg/CameraInfo" />
            <param name="bridges.camera_info.gz_type_name" value="gz.msgs.CameraInfo" />
            <param name="bridges.camera_info.direction" value="GZ_TO_ROS" />
            <param name="bridges.camera_info.frame_id" value="$(var frame_id)" />
        </composable_node>
    </load_composable_node>
</launch>
